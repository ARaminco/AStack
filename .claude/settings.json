{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/bin/astack.mjs\" interop hook session-start --runtime claude-code",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/bin/astack.mjs\" interop hook session-end --runtime claude-code",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/bin/astack-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "astack",
    "astack-browser"
  ],
  "permissions": {
    "allow": [
      "mcp__astack",
      "mcp__astack-browser__browser_snapshot",
      "mcp__astack-browser__browser_take_screenshot",
      "mcp__astack-browser__browser_console_messages",
      "mcp__astack-browser__browser_network_requests",
      "mcp__astack-browser__browser_wait_for",
      "mcp__astack-browser__browser_navigate",
      "mcp__astack-browser__browser_navigate_back",
      "mcp__astack-browser__browser_resize"
    ]
  }
}
