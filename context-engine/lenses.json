{
  "version": 2,
  "defaults": {
    "maxFileBytes": 1572864,
    "maxScanLines": 4000,
    "ignore": [
      ".git",
      "node_modules",
      "vendor",
      "dist",
      "build",
      "coverage",
      ".next",
      ".nuxt",
      ".venv",
      "__pycache__",
      ".astack/cache",
      ".astack/backups",
      ".astack/context",
      ".astack/browser/profiles",
      ".DS_Store"
    ],
    "alwaysInclude": [
      "astack.config.yaml",
      "CLAUDE.md",
      "README.md",
      "package.json"
    ],
    "opaqueExtensions": [
      ".pdf",
      ".docx",
      ".doc",
      ".xlsx",
      ".xls",
      ".pptx",
      ".ppt",
      ".png",
      ".jpg",
      ".jpeg",
      ".gif",
      ".webp",
      ".svg",
      ".mp3",
      ".wav",
      ".m4a",
      ".ogg",
      ".mp4",
      ".mov",
      ".zip",
      ".rar",
      ".7z",
      ".ico",
      ".woff",
      ".woff2",
      ".ttf",
      ".eot",
      ".bin",
      ".exe",
      ".dll",
      ".psd",
      ".ai",
      ".dwg"
    ]
  },
  "genericSignals": [
    {
      "id": "email",
      "label": "email",
      "labelFa": "ایمیل",
      "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
      "weight": 1.1
    },
    {
      "id": "url",
      "label": "url",
      "labelFa": "نشانی",
      "pattern": "https?://[^\\s\"'<>)\\]]{6,120}",
      "weight": 0.6
    },
    {
      "id": "iso-date",
      "label": "date",
      "labelFa": "تاریخ",
      "pattern": "\\b(20[0-9]{2}-[01][0-9]-[0-3][0-9])\\b",
      "weight": 0.5
    },
    {
      "id": "jalali-date",
      "label": "jalali date",
      "labelFa": "تاریخ شمسی",
      "pattern": "\\b(1[34][0-9]{2}/[01]?[0-9]/[0-3]?[0-9])\\b",
      "weight": 0.9
    },
    {
      "id": "national-id",
      "label": "national id",
      "labelFa": "شناسه ملی",
      "pattern": "(?:شناسه\\s*ملی|کد\\s*ملی|national\\s*id)\\s*[:#-]?\\s*([0-9]{8,14})",
      "weight": 1.6
    }
  ],
  "lenses": [
    {
      "id": "software",
      "domains": [
        "software"
      ],
      "nameFa": "نرم‌افزار",
      "kindWeights": {
        "code": 1.4,
        "config": 1.1,
        "doc": 0.8,
        "data": 0.9,
        "opaque": 0.3
      },
      "criticalPaths": [
        "package.json",
        "composer.json",
        "astack.config.yaml",
        "docker-compose.yml",
        "Dockerfile",
        ".github/workflows"
      ],
      "signals": [
        {
          "id": "http-route",
          "label": "route",
          "labelFa": "مسیر",
          "pattern": "(?:app\\.(?:get|post|put|patch|delete)|router\\.(?:get|post|put|patch|delete)|Route::(?:get|post|put|patch|delete))\\s*\\(\\s*[\"'`]([^\"'`]{1,80})",
          "weight": 1.8
        },
        {
          "id": "env-var",
          "label": "env",
          "labelFa": "متغیر محیطی",
          "pattern": "process\\.env\\.([A-Z0-9_]{3,40})",
          "weight": 1.2
        },
        {
          "id": "db-table",
          "label": "table",
          "labelFa": "جدول",
          "pattern": "(?:CREATE\\s+TABLE(?:\\s+IF\\s+NOT\\s+EXISTS)?|Schema::create)\\s*\\(?\\s*[\"'`]?([A-Za-z0-9_]{2,40})",
          "weight": 1.6
        },
        {
          "id": "cli-command",
          "label": "command",
          "labelFa": "فرمان",
          "pattern": "(?:command\\s*===?\\s*|case\\s+)[\"']([a-z][a-z0-9:-]{2,30})[\"']",
          "weight": 1.1
        }
      ]
    },
    {
      "id": "legal",
      "domains": [
        "legal"
      ],
      "nameFa": "حقوقی",
      "kindWeights": {
        "code": 0.4,
        "config": 0.6,
        "doc": 1.6,
        "data": 1,
        "opaque": 1.3
      },
      "criticalPaths": [
        "case",
        "cases",
        "pronde",
        "contracts",
        "قرارداد",
        "پرونده",
        "لوایح"
      ],
      "signals": [
        {
          "id": "case-number",
          "label": "case number",
          "labelFa": "شماره پرونده",
          "pattern": "(?:کلاسه|پرونده\\s*(?:شماره|کلاسه)?|case\\s*(?:no\\.?|number)|docket)\\s*[:#-]?\\s*([0-9]{2,6}[/\\-][0-9]{2,6}(?:[/\\-][0-9]{1,6})?)",
          "weight": 3.2,
          "linking": true
        },
        {
          "id": "court",
          "label": "court",
          "labelFa": "مرجع",
          "pattern": "(?:شعبه\\s*[0-9]{1,3}\\s*(?:دادگاه|دادسرا|بازپرسی)[^\\n،.]{0,40}|دیوان\\s*عدالت\\s*اداری|دادگاه\\s*تجدیدنظر[^\\n،.]{0,30})",
          "weight": 2.1
        },
        {
          "id": "party",
          "label": "party",
          "labelFa": "طرف پرونده",
          "pattern": "(?:خواهان|خوانده|شاکی|متهم|وکیل\\s*مدافع|plaintiff|defendant|claimant|respondent)\\s*[:：]\\s*([\\u0600-\\u06FFA-Za-z][^\\n،.؛]{2,46})",
          "weight": 2.4,
          "linking": true
        },
        {
          "id": "hearing",
          "label": "hearing",
          "labelFa": "وقت رسیدگی",
          "pattern": "(?:جلسه\\s*رسیدگی|وقت\\s*رسیدگی|hearing\\s*date)\\s*[:：-]?\\s*([0-9]{2,4}[/\\-][0-9]{1,2}[/\\-][0-9]{1,2})",
          "weight": 2.6
        },
        {
          "id": "statute",
          "label": "statute",
          "labelFa": "مستند قانونی",
          "pattern": "ماده\\s*([0-9]{1,4})\\s*(?:قانون|ق\\.)([^\\n،.]{0,40})",
          "weight": 1.7
        },
        {
          "id": "contract-ref",
          "label": "contract",
          "labelFa": "قرارداد",
          "pattern": "(?:قرارداد\\s*(?:شماره|شمارهٔ)?|agreement\\s*(?:no\\.?|number))\\s*[:#-]?\\s*([A-Za-z0-9\\-/]{3,24})",
          "weight": 2.2,
          "linking": true
        }
      ]
    },
    {
      "id": "finance",
      "domains": [
        "finance",
        "accounting",
        "tax"
      ],
      "nameFa": "مالی و حسابداری",
      "kindWeights": {
        "code": 0.5,
        "config": 0.8,
        "doc": 1.4,
        "data": 1.7,
        "opaque": 1.2
      },
      "criticalPaths": [
        "ledger",
        "journal",
        "statements",
        "دفتر",
        "تراز",
        "صورت‌های مالی",
        "اظهارنامه"
      ],
      "signals": [
        {
          "id": "amount",
          "label": "amount",
          "labelFa": "مبلغ",
          "pattern": "([0-9][0-9,،.]{2,20})\\s*(?:ریال|تومان|درهم|دلار|یورو|USD|EUR|AED|IRR|IRT)",
          "weight": 1.9
        },
        {
          "id": "invoice",
          "label": "invoice",
          "labelFa": "فاکتور",
          "pattern": "(?:فاکتور|صورتحساب|invoice)\\s*(?:شماره|no\\.?|#)?\\s*[:#-]?\\s*([A-Za-z0-9][A-Za-z0-9\\-/]{2,23})",
          "weight": 2.6,
          "linking": true
        },
        {
          "id": "account-code",
          "label": "account",
          "labelFa": "کد حساب",
          "pattern": "(?:کد\\s*حساب|شماره\\s*حساب|account\\s*(?:code|no\\.?|number))\\s*[:#-]?\\s*([0-9\\-]{4,26})",
          "weight": 2.3,
          "linking": true
        },
        {
          "id": "iban",
          "label": "iban",
          "labelFa": "شبا",
          "pattern": "\\b(IR[0-9]{24})\\b",
          "weight": 2.8,
          "linking": true
        },
        {
          "id": "fiscal-period",
          "label": "period",
          "labelFa": "دوره مالی",
          "pattern": "(?:دوره\\s*مالی|سال\\s*مالی|fiscal\\s*(?:year|period))\\s*[:#-]?\\s*([0-9]{4}(?:[-/][0-9]{1,2})?)",
          "weight": 2,
          "linking": true
        },
        {
          "id": "tax-file",
          "label": "tax id",
          "labelFa": "کد اقتصادی",
          "pattern": "(?:کد\\s*اقتصادی|شماره\\s*اقتصادی|tax\\s*(?:id|file))\\s*[:#-]?\\s*([0-9]{8,16})",
          "weight": 2.7,
          "linking": true
        },
        {
          "id": "vat",
          "label": "vat",
          "labelFa": "ارزش افزوده",
          "pattern": "(?:ارزش\\s*افزوده|VAT|اظهارنامه\\s*مالیاتی)",
          "weight": 0.7
        }
      ]
    },
    {
      "id": "operations",
      "domains": [
        "operations",
        "hr",
        "marketing",
        "research",
        "business"
      ],
      "nameFa": "عملیات و کسب‌وکار",
      "kindWeights": {
        "code": 0.7,
        "config": 0.9,
        "doc": 1.5,
        "data": 1.2,
        "opaque": 0.9
      },
      "criticalPaths": [
        "charter",
        "policy",
        "sop",
        "منشور",
        "دستورالعمل",
        "سیاست"
      ],
      "signals": [
        {
          "id": "kpi",
          "label": "kpi",
          "labelFa": "شاخص",
          "pattern": "(?:KPI|OKR|شاخص\\s*کلیدی|هدف\\s*کلیدی)\\s*[:：]\\s*([^\\n]{3,60})",
          "weight": 1.8
        },
        {
          "id": "sla",
          "label": "sla",
          "labelFa": "تعهد سطح خدمت",
          "pattern": "(?:SLA|سطح\\s*خدمت|زمان\\s*پاسخ)\\s*[:：]\\s*([^\\n]{3,50})",
          "weight": 1.6
        },
        {
          "id": "person",
          "label": "person",
          "labelFa": "شخص",
          "pattern": "(?:مسئول|مالک|owner|assignee|responsible)\\s*[:：]\\s*([\\u0600-\\u06FFA-Za-z][^\\n،.؛]{2,38})",
          "weight": 1.4,
          "linking": true
        },
        {
          "id": "deadline",
          "label": "deadline",
          "labelFa": "مهلت",
          "pattern": "(?:مهلت|سررسید|deadline|due\\s*date)\\s*[:：-]?\\s*([0-9]{2,4}[/\\-][0-9]{1,2}[/\\-][0-9]{1,2})",
          "weight": 2
        }
      ]
    }
  ]
}
