{
  "name": "astack-enterprise",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AStack Enterprise AI Engineering Operating System.",
  "bin": {
    "astack": "./bin/astack.mjs"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap-enterprise.mjs",
